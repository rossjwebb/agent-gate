--- /dev/null
+++ b/agent-gate/src/agent_gate/checks.py
@@ -0,0 +1,65 @@
+"""Stable policy rules for agent definitions."""
+
+from dataclasses import dataclass
+
+from .policy import Policy, validate_field
+
+
+AGENT_FIELDS = {
+    "name": "string",
+    "owner": "string",
+    "model": "string",
+    "monthly_budget_gbp": "budget",
+    "tools": "strings",
+    "human_approval_for": "strings",
+    "max_steps": "steps",
+}
+
+
+@dataclass(frozen=True)
+class Violation:
+    agent: str
+    rule_id: str
+    message: str
+
+
+def check_agent(data: dict, policy: Policy, fallback_name: str) -> list[Violation]:
+    for key, kind in AGENT_FIELDS.items():
+        if key in data:
+            validate_field(key, data[key], kind)
+
+    name = data.get("name", "").strip() or fallback_name
+    violations = []
+
+    def fail(rule: str, message: str) -> None:
+        violations.append(Violation(name, rule, message))
+
+    if data.get("model") not in policy.allowed_models:
+        fail("AG001", f"model {data.get('model')!r} is not on the allowlist")
+
+    budget = data.get("monthly_budget_gbp")
+    if budget is None:
+        fail("AG002", "monthly_budget_gbp is missing")
+    elif budget > policy.max_monthly_budget_gbp:
+        fail("AG002", f"monthly_budget_gbp {budget} exceeds cap {policy.max_monthly_budget_gbp}")
+
+    unapproved = (
+        set(data.get("tools", []))
+        & set(policy.risky_tools)
+        - set(data.get("human_approval_for", []))
+    )
+    for tool in sorted(unapproved):
+        fail("AG003", f"risky tool {tool!r} requires human_approval_for")
+
+    steps = data.get("max_steps")
+    if steps is None:
+        fail("AG004", "max_steps is missing")
+    elif steps > policy.max_steps:
+        fail("AG004", f"max_steps {steps} exceeds cap {policy.max_steps}")
+
+    if policy.require_owner and not data.get("owner", "").strip():
+        fail("AG005", "owner is required")
+
+    for key in sorted(data.keys() - AGENT_FIELDS.keys()):
+        fail("AG006", f"unknown agent field {key!r}")
+    return violations
diff --git a/agent-gate/src/agent_gate/cli.py b/agent-gate/src/agent_gate/cli.py
new file mode 100644
index 0000000000000000000000000000000000000000..813134b3c1d6edb6c14c81b967e995bea89768c0
--- /dev/null
+++ b/agent-gate/src/agent_gate/cli.py
@@ -0,0 +1,48 @@
+"""Command-line entry point."""
+
+import argparse
+from pathlib import Path
+import sys
+
+from .checks import check_agent
+from .policy import Policy, load_toml
+from .report import render
+
+
+def agent_files(path: Path) -> list[Path]:
+    if path.is_file():
+        return [path]
+    if not path.is_dir():
+        raise ValueError(f"{path}: agent path does not exist or is not a file/directory")
+    files = sorted(path.rglob("*.toml"))
+    files = [file for file in files if file.is_file()]
+    if not files:
+        raise ValueError(f"{path}: no agent TOML files found")
+    return files
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(prog="agent-gate")
+    commands = parser.add_subparsers(dest="command", required=True)
+    check = commands.add_parser("check", help="check agents against a policy")
+    check.add_argument("--policy", type=Path, required=True)
+    check.add_argument("--format", choices=("text", "json"), default="text")
+    check.add_argument("agents", type=Path, help="agent TOML file or directory (recursive)")
+    args = parser.parse_args(argv)
+
+    try:
+        policy = Policy.load(args.policy)
+        files = agent_files(args.agents)
+        violations = []
+        for path in files:
+            data = load_toml(path)
+            try:
+                violations.extend(check_agent(data, policy, path.stem))
+            except ValueError as exc:
+                raise ValueError(f"{path}: {exc}") from None
+    except (ValueError, OSError) as exc:
+        print(f"agent-gate: error: {exc}", file=sys.stderr)
+        return 2
+
+    print(render(violations, len(files), args.format))
+    return 1 if violations else 0
diff --git a/agent-gate/src/agent_gate/policy.py b/agent-gate/src/agent_gate/policy.py
new file mode 100644
index 0000000000000000000000000000000000000000..fa96479b447553b9094ccd34dfeb0ed2f3f8e233
--- /dev/null
+++ b/agent-gate/src/agent_gate/policy.py
@@ -0,0 +1,70 @@
+"""TOML loading and policy validation."""
+
+from dataclasses import dataclass
+import math
+from pathlib import Path
+import tomllib
+
+
+def load_toml(path: Path) -> dict:
+    try:
+        with path.open("rb") as stream:
+            return tomllib.load(stream)
+    except (OSError, UnicodeError, ValueError) as exc:
+        raise ValueError(f"{path}: {exc}") from None
+
+
+def validate_field(key: str, value: object, kind: str) -> None:
+    """Reject malformed values rather than silently skipping policy checks."""
+    if kind == "strings":
+        valid = isinstance(value, list) and all(
+            isinstance(item, str) and item.strip() for item in value
+        )
+        expected = "a list of non-empty strings"
+    elif kind == "budget":
+        valid = type(value) in (int, float) and value >= 0
+        if type(value) is float:
+            valid = valid and math.isfinite(value)
+        expected = "a finite, non-negative number"
+    elif kind == "steps":
+        valid = type(value) is int and value > 0
+        expected = "a positive integer"
+    elif kind == "bool":
+        valid = type(value) is bool
+        expected = "a boolean"
+    else:
+        valid = isinstance(value, str)
+        expected = "a string"
+    if not valid:
+        raise ValueError(f"{key} must be {expected}")
+
+
+@dataclass(frozen=True)
+class Policy:
+    allowed_models: list[str]
+    max_monthly_budget_gbp: int | float
+    max_steps: int
+    risky_tools: list[str]
+    require_owner: bool
+
+    @classmethod
+    def load(cls, path: Path) -> "Policy":
+        data = load_toml(path)
+        fields = {
+            "allowed_models": "strings",
+            "max_monthly_budget_gbp": "budget",
+            "max_steps": "steps",
+            "risky_tools": "strings",
+            "require_owner": "bool",
+        }
+        try:
+            unknown = sorted(data.keys() - fields.keys())
+            if unknown:
+                raise ValueError(f"unknown policy field(s): {', '.join(unknown)}")
+            for key, kind in fields.items():
+                if key not in data:
+                    raise ValueError(f"missing policy field: {key}")
+                validate_field(key, data[key], kind)
+        except ValueError as exc:
+            raise ValueError(f"{path}: {exc}") from None
+        return cls(**data)
diff --git a/agent-gate/src/agent_gate/report.py b/agent-gate/src/agent_gate/report.py
new file mode 100644
index 0000000000000000000000000000000000000000..dfe029b423544d0f75c16ccca39ddd6c60d51fae
--- /dev/null
+++ b/agent-gate/src/agent_gate/report.py
@@ -0,0 +1,18 @@
+"""Text and JSON reports with deterministic ordering."""
+
+from dataclasses import asdict
+import json
+
+from .checks import Violation
+
+
+def render(violations: list[Violation], agent_count: int, format: str) -> str:
+    if format == "json":
+        return json.dumps([asdict(item) for item in violations], indent=2)
+    lines = [
+        f"FAIL {json.dumps(item.agent, ensure_ascii=False)[1:-1]} {item.rule_id} {item.message}"
+        for item in violations
+    ]
+    status = "FAIL" if violations else "PASS"
+    lines.append(f"{status}: checked {agent_count} agent(s); {len(violations)} violation(s)")
+    return "\n".join(lines)
diff --git a/agent-gate/tests/test_agent_gate.py b/agent-gate/tests/test_agent_gate.py
new file mode 100644
index 0000000000000000000000000000000000000000..8f53ade64f5e5c0030379718d767f07a0b5c1c64
--- /dev/null
+++ b/agent-gate/tests/test_agent_gate.py
@@ -0,0 +1,207 @@
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "src"))
+
+from agent_gate.checks import check_agent
+from agent_gate.policy import Policy
+
+
+class RuleTests(unittest.TestCase):
+    def setUp(self):
+        self.policy = Policy(["approved"], 50, 20, ["send_email", "make_payment"], True)
+        self.agent = {
+            "name": "example",
+            "owner": "accounts",
+            "model": "approved",
+            "monthly_budget_gbp": 50,
+            "tools": ["read_invoices", "send_email"],
+            "human_approval_for": ["send_email"],
+            "max_steps": 20,
+        }
+
+    def rules(self):
+        return [item.rule_id for item in check_agent(self.agent, self.policy, "fallback")]
+
+    def test_compliant_at_caps(self):
+        self.assertEqual(self.rules(), [])
+
+    def test_ag001_unapproved_or_missing_model(self):
+        self.agent["model"] = "other"
+        self.assertEqual(self.rules(), ["AG001"])
+        del self.agent["model"]
+        self.assertEqual(self.rules(), ["AG001"])
+
+    def test_ag002_over_cap_or_missing_budget(self):
+        self.agent["monthly_budget_gbp"] = 50.01
+        self.assertEqual(self.rules(), ["AG002"])
+        del self.agent["monthly_budget_gbp"]
+        self.assertEqual(self.rules(), ["AG002"])
+
+    def test_ag003_each_unapproved_risky_tool_once(self):
+        self.agent["tools"] += ["make_payment", "send_email"]
+        self.agent["human_approval_for"] = []
+        results = check_agent(self.agent, self.policy, "fallback")
+        self.assertEqual([item.rule_id for item in results], ["AG003", "AG003"])
+        self.assertIn("make_payment", results[0].message)
+        self.assertIn("send_email", results[1].message)
+
+    def test_ag003_missing_approval_list(self):
+        del self.agent["human_approval_for"]
+        self.assertEqual(self.rules(), ["AG003"])
+
+    def test_unused_risky_tools_need_no_approval(self):
+        self.agent["tools"] = ["read_invoices"]
+        self.agent["human_approval_for"] = []
+        self.assertEqual(self.rules(), [])
+
+    def test_ag004_over_cap_or_missing_steps(self):
+        self.agent["max_steps"] = 21
+        self.assertEqual(self.rules(), ["AG004"])
+        del self.agent["max_steps"]
+        self.assertEqual(self.rules(), ["AG004"])
+
+    def test_ag005_missing_or_blank_owner(self):
+        del self.agent["owner"]
+        self.assertEqual(self.rules(), ["AG005"])
+        self.agent["owner"] = "  "
+        self.assertEqual(self.rules(), ["AG005"])
+
+    def test_owner_optional(self):
+        del self.agent["owner"]
+        policy = Policy(["approved"], 50, 20, [], False)
+        self.assertEqual(check_agent(self.agent, policy, "fallback"), [])
+
+    def test_ag006_typo_does_not_grant_approval(self):
+        self.agent["human_aproval_for"] = self.agent.pop("human_approval_for")
+        self.assertEqual(self.rules(), ["AG003", "AG006"])
+
+    def test_fallback_name(self):
+        del self.agent["name"]
+        del self.agent["owner"]
+        self.assertEqual(check_agent(self.agent, self.policy, "fallback")[0].agent, "fallback")
+
+    def test_invalid_types_and_ranges_are_errors(self):
+        cases = [
+            ("monthly_budget_gbp", True), ("monthly_budget_gbp", -1),
+            ("monthly_budget_gbp", float("nan")), ("monthly_budget_gbp", float("inf")),
+            ("max_steps", True), ("max_steps", 2.5), ("max_steps", 0),
+            ("tools", "send_email"), ("tools", [1]),
+            ("human_approval_for", [False]), ("owner", 42), ("name", []),
+        ]
+        for field, value in cases:
+            with self.subTest(field=field, value=value):
+                agent = {**self.agent, field: value}
+                with self.assertRaisesRegex(ValueError, field):
+                    check_agent(agent, self.policy, "fallback")
+
+
+class CliTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.directory = Path(self.temp.name)
+        self.policy = ROOT / "examples" / "policy.toml"
+
+    def run_cli(self, *args):
+        env = {**os.environ, "PYTHONPATH": str(ROOT / "src")}
+        return subprocess.run(
+            [sys.executable, "-m", "agent_gate", *map(str, args)],
+            cwd=self.directory, env=env, text=True, capture_output=True,
+        )
+
+    def check(self, path, *args):
+        return self.run_cli("check", "--policy", self.policy, path, *args)
+
+    def assert_error(self, result):
+        self.assertEqual(result.returncode, 2)
+        self.assertIn("error:", result.stderr)
+        self.assertNotIn("Traceback", result.stderr)
+        self.assertEqual(result.stdout, "")
+
+    def test_pass_exit_and_text_summary(self):
+        result = self.check(ROOT / "examples" / "invoice-chaser.toml")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stdout, "PASS: checked 1 agent(s); 0 violation(s)\n")
+
+    def test_violation_exit_and_text_lines(self):
+        result = self.check(ROOT / "examples" / "social-poster.toml")
+        self.assertEqual(result.returncode, 1, result.stderr)
+        lines = result.stdout.splitlines()
+        self.assertEqual(len(lines), 7)
+        for index, line in enumerate(lines[:-1], 1):
+            self.assertTrue(line.startswith(f"FAIL social-poster AG00{index} "), line)
+        self.assertEqual(lines[-1], "FAIL: checked 1 agent(s); 6 violation(s)")
+
+    def test_json_list_schema_and_pass(self):
+        result = self.check(ROOT / "examples" / "social-poster.toml", "--format", "json")
+        self.assertEqual(result.returncode, 1)
+        items = json.loads(result.stdout)
+        self.assertEqual([item["rule_id"] for item in items], [f"AG00{i}" for i in range(1, 7)])
+        for item in items:
+            self.assertEqual(set(item), {"agent", "rule_id", "message"})
+            self.assertEqual(item["agent"], "social-poster")
+            self.assertIsInstance(item["message"], str)
+        result = self.check(ROOT / "examples" / "invoice-chaser.toml", "--format", "json")
+        self.assertEqual(result.returncode, 0)
+        self.assertEqual(json.loads(result.stdout), [])
+
+    def test_recursive_directory_and_stable_order(self):
+        content = (ROOT / "examples" / "social-poster.toml").read_text()
+        (self.directory / "z.toml").write_text(content.replace("social-poster", "last"))
+        nested = self.directory / "nested"
+        nested.mkdir()
+        (nested / "a.toml").write_text(content.replace("social-poster", "first"))
+        (self.directory / "ignored.txt").write_text("not TOML")
+        first = self.check(self.directory, "--format", "json")
+        second = self.check(self.directory, "--format", "json")
+        self.assertEqual(first.returncode, 1)
+        self.assertEqual(first.stdout, second.stdout)
+        self.assertEqual([item["agent"] for item in json.loads(first.stdout)], ["first"] * 6 + ["last"] * 6)
+
+    def test_malformed_agent_toml(self):
+        path = self.directory / "broken.toml"
+        path.write_text('name = "unterminated')
+        result = self.check(path)
+        self.assert_error(result)
+        self.assertIn("broken.toml", result.stderr)
+
+    def test_malformed_or_invalid_policy(self):
+        original = self.policy.read_text()
